# ============================================
# Environment Configuration Template
# ============================================
# Copy this file to .env and fill in REAL values.
# NEVER put real credentials here — this file is committed to git.
# ============================================

# --- Flask ---
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=True
SECRET_KEY=generate-a-random-64-char-string-here

# --- CORS (comma-separated allowed origins) ---
# In production, set this to your Render/Vercel URL
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# --- MongoDB ---
# Use MongoDB Atlas for production: mongodb+srv://user:pass@cluster.mongodb.net/dbname
MONGO_URI=mongodb://localhost:27017/aquaguard

# --- Twilio SMS Alerts (optional) ---
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
ALERT_PHONE_NUMBER=+91xxxxxxxxxx

# --- Model Paths ---
YOLO_WEIGHTS_DIR=models/weights
ML_MODEL_PATH=models/weights/outbreak_model.pkl

# --- Risk Thresholds ---
HIGH_RISK_THRESHOLD=70
MEDIUM_RISK_THRESHOLD=40

# ============================================
# How to generate SECRET_KEY (run in Python):
#   import secrets; print(secrets.token_hex(32))
# ============================================
