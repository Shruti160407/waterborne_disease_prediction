# ML Model weights & binaries (too large for git)
# ============================================
*.pt
*.joblib
weights/
runs/
models/weights/*.pt
models/weights/yolo_runs/

# Keep small trained models (< 5MB) — comment out if you want to exclude them too
!models/weights/outbreak_model.pkl
!models/weights/feature_scaler.pkl
!models/weights/model_metadata.json

